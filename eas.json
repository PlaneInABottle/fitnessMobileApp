{
  "cli": {
    "version": ">= 21.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.18.0",
      "bun": "1.3.14",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "development:device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.18.0",
      "bun": "1.3.14",
      "android": {
        "buildType": "apk"
      }
    },
    "preview:simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "node": "24.18.0",
      "bun": "1.3.14",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
