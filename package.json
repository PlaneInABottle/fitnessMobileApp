{
  "name": "fitness-tracker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:web": "bunx expo export --platform web",
    "serve:web": "bunx serve dist",
    "prebuild:clean": "bunx expo prebuild --clean",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "deps:check": "depcruise app --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise app --include-only \"^app\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "bunx expo install --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.planeinabottle.fitnesstracker .maestro/flows",
    "exercises:import:videos": "bun scripts/import-exercise-videos.mjs scripts/sources/ymove-free.tsv scripts/sources/wger-videos.json",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "bunx eas-cli@21.0.1 build --profile development --platform ios",
    "build:ios:device": "bunx eas-cli@21.0.1 build --profile development:device --platform ios",
    "build:ios:preview": "bunx eas-cli@21.0.1 build --profile preview:simulator --platform ios",
    "build:ios:prod": "bunx eas-cli@21.0.1 build --profile production --platform ios",
    "build:android:sim": "bunx eas-cli@21.0.1 build --profile development --platform android --local",
    "build:android:device": "bunx eas-cli@21.0.1 build --profile development:device --platform android --local",
    "build:android:preview": "bunx eas-cli@21.0.1 build --profile preview --platform android --local",
    "build:android:prod": "bunx eas-cli@21.0.1 build --profile production --platform android --local"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~57.0.5",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.6",
    "expo-build-properties": "~57.0.5",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-splash-screen": "~57.0.4",
    "expo-system-ui": "~57.0.1",
    "expo-video": "~57.0.1",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^7.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.0.1",
    "react-native": "0.86.0",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "3.3.3",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "setimmediate": "^1.0.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.20.0",
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "ts-jest": "^29.4.11",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@isaacs/brace-expansion": "5.0.1",
    "@tootallnate/once": "2.0.1",
    "@xmldom/xmldom": "0.8.13",
    "ajv": "6.15.0",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "shell-quote": "1.10.0",
    "uuid": "11.1.1",
    "yaml": "2.9.0"
  }
}
